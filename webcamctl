#!/usr/bin/env bash

set -o nounset
set -o pipefail
shopt -s nullglob

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

require_v4l2_ctl() {
  command -v v4l2-ctl >/dev/null 2>&1 || die "v4l2-ctl is required. Install the v4l-utils package."
}

clean_field() {
  local value="$1"
  value="${value//$'\t'/ }"
  value="${value//$'\r'/ }"
  value="${value//$'\n'/ }"
  printf '%s' "$value"
}

device_info() {
  local device="$1"
  local line in_capabilities=false in_device_caps=false saw_device_caps=false
  local capabilities_capture=false device_caps_capture=false
  DEVICE_INFO=""
  DEVICE_BUS=""
  DEVICE_IS_CAPTURE=false

  DEVICE_INFO="$(v4l2-ctl --device="$device" --info 2>/dev/null)" || return 1
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*Bus[[:space:]]+info[[:space:]]*:[[:space:]]*(.*)$ ]]; then
      DEVICE_BUS="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ ^[[:space:]]*Capabilities[[:space:]]*: ]]; then
      in_capabilities=true
      in_device_caps=false
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]*Device[[:space:]]+Caps[[:space:]]*: ]]; then
      saw_device_caps=true
      in_capabilities=false
      in_device_caps=true
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]+(Video[[:space:]]+Capture|Video[[:space:]]+Capture[[:space:]]+Multiplanar)[[:space:]]*$ ]]; then
      if [[ "$in_device_caps" == true ]]; then
        device_caps_capture=true
      elif [[ "$in_capabilities" == true ]]; then
        capabilities_capture=true
      fi
    fi
  done <<< "$DEVICE_INFO"
  if [[ "$saw_device_caps" == true ]]; then
    DEVICE_IS_CAPTURE="$device_caps_capture"
  else
    DEVICE_IS_CAPTURE="$capabilities_capture"
  fi
}

device_record() {
  local sys_device="$1"
  local node="/dev/${sys_device##*/}"
  local name="${node##*/}" sys_path="" detail=""

  [[ -c "$node" ]] || return 1
  device_info "$node" || return 1
  [[ "$DEVICE_IS_CAPTURE" == true ]] || return 1

  if [[ -r "$sys_device/name" ]]; then
    IFS= read -r name < "$sys_device/name" || true
  fi
  sys_path="$(readlink -f "$sys_device/device" 2>/dev/null)" || sys_path=""
  sys_path="${sys_path#/sys/devices/}"
  if [[ -n "$DEVICE_BUS" && -n "$sys_path" ]]; then
    detail="$DEVICE_BUS | $sys_path"
  elif [[ -n "$DEVICE_BUS" ]]; then
    detail="$DEVICE_BUS"
  else
    detail="$sys_path"
  fi

  printf 'DEVICE\t%s\t%s\t%s\n' \
    "$node" "$(clean_field "$name")" "$(clean_field "$detail")"
}

devices() {
  local sys_device
  for sys_device in /sys/class/video4linux/video*; do
    device_record "$sys_device" || true
  done
}

detect_device() {
  local requested="${1:-}"
  local sys_device record

  if [[ -n "$requested" ]]; then
    [[ "$requested" =~ ^/dev/video[0-9]+$ ]] || die "Invalid video device: $requested" 2
    [[ -c "$requested" ]] || die "Video device not found: $requested" 2
    sys_device="/sys/class/video4linux/${requested##*/}"
    [[ -d "$sys_device" ]] || die "Video device is not registered by V4L2: $requested" 2
    record="$(device_record "$sys_device")" || die "Video device is not a capture node: $requested" 2
    printf '%s\n' "$record"
    return
  fi

  for sys_device in /sys/class/video4linux/video*; do
    record="$(device_record "$sys_device")" || continue
    printf '%s\n' "$record"
    return
  done

  die "No V4L2 video capture device was detected." 2
}

state() {
  local record device
  record="$(detect_device "${1:-}")" || exit $?
  device="${record#*$'\t'}"
  device="${device%%$'\t'*}"
  printf '%s\n' "$record"
  v4l2-ctl --device="$device" --list-ctrls-menus
}

control_type() {
  local device="$1" control="$2" output line body flags pattern
  output="$(v4l2-ctl --device="$device" --list-ctrls-menus 2>/dev/null)" || return 1
  pattern="^[[:space:]]*${control}[[:space:]]+0x[0-9a-fA-F]+[[:space:]]+\\(([^)]+)\\)[[:space:]]*:[[:space:]]*(.*)$"
  while IFS= read -r line; do
    if [[ "$line" =~ $pattern ]]; then
      CONTROL_TYPE="${BASH_REMATCH[1],,}"
      body="${BASH_REMATCH[2]}"
      if [[ "$body" == *"flags="* ]]; then
        flags="${body#*flags=}"
        flags="${flags//[[:space:]]/}"
        case ",$flags," in
          *,read-only,*) return 1 ;;
          *,has-payload,*)
            [[ "$CONTROL_TYPE" == "str" || "$CONTROL_TYPE" == "string" ]] || return 1
            ;;
        esac
      fi
      return 0
    fi
  done <<< "$output"
  return 1
}

set_control() {
  local device="$1" control="$2" value="$3"

  [[ "$device" =~ ^/dev/video[0-9]+$ && -c "$device" ]] || die "Video device not found: $device" 2
  device_info "$device" && [[ "$DEVICE_IS_CAPTURE" == true ]] || die "Video device is not a capture node: $device" 2
  [[ "$control" =~ ^[A-Za-z0-9_]+$ ]] || die "Invalid V4L2 control name: $control"
  ((${#value} <= 4096)) || die "V4L2 control value is too long."
  [[ "$value" != *[$'\t\r\n,']* ]] || die "V4L2 control value contains an unsafe separator."
  control_type "$device" "$control" || die "Control is missing, read-only, or uses an unsupported payload: $control" 2

  case "$CONTROL_TYPE" in
    int|integer|int64|bool|boolean|menu|intmenu|bitmask|button)
      [[ "$value" =~ ^-?(0[xX][0-9a-fA-F]+|[0-9]+)$ ]] || die "Control $control requires a decimal or hexadecimal value."
      ;;
    str|string)
      ;;
    *)
      die "Control type cannot be set generically: $CONTROL_TYPE" 2
      ;;
  esac

  v4l2-ctl --device="$device" --set-ctrl="${control}=${value}"
}

usb_device_for_node() {
  local node="$1" path
  [[ "$node" =~ ^/dev/video[0-9]+$ ]] || return 1
  path="$(readlink -f "/sys/class/video4linux/${node##*/}/device" 2>/dev/null)" || return 1
  while [[ -n "$path" && "$path" != "/" ]]; do
    if [[ -f "$path/idVendor" && -f "$path/authorized" ]]; then
      printf '%s\n' "${path##*/}"
      return 0
    fi
    path="${path%/*}"
  done
  return 1
}

usb_device_has_video_interface() {
  local class_file
  for class_file in "$1"/*/bInterfaceClass; do
    [[ -r "$class_file" ]] || continue
    [[ "$(<"$class_file")" == "0e" ]] && return 0
  done
  return 1
}

usb_device_name() {
  local dir="$1" manufacturer="" product=""
  [[ -r "$dir/manufacturer" ]] && IFS= read -r manufacturer < "$dir/manufacturer" || true
  [[ -r "$dir/product" ]] && IFS= read -r product < "$dir/product" || true
  if [[ -n "$product" && -n "$manufacturer" && "$product" != *"$manufacturer"* ]]; then
    printf '%s %s' "$manufacturer" "$product"
  else
    printf '%s' "${product:-$manufacturer}"
  fi
}

validate_usb_id() {
  [[ "$1" =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]] || die "Invalid USB device id: $1" 2
  [[ -d "/sys/bus/usb/devices/$1" && -f "/sys/bus/usb/devices/$1/idVendor" ]] \
    || die "USB device not found: $1" 2
}

# Prints: POWER <usb-id> <on|off|unsupported> <writable|locked> <name>
power_state() {
  local target="${1:-}" usb_id="" dir record device
  if [[ "$target" =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]]; then
    usb_id="$target"
  else
    record="$(detect_device "$target" 2>/dev/null)" || {
      # No capture node: nothing to map, the caller may retry with a stored USB id.
      printf 'POWER\t\tunsupported\tlocked\t\n'
      return 0
    }
    device="${record#*$'\t'}"
    device="${device%%$'\t'*}"
    usb_id="$(usb_device_for_node "$device")" || {
      printf 'POWER\t\tunsupported\tlocked\t\n'
      return 0
    }
  fi
  validate_usb_id "$usb_id"
  dir="/sys/bus/usb/devices/$usb_id"
  local state="off" access="locked"
  [[ "$(<"$dir/authorized")" == "1" ]] && state="on"
  [[ -w "$dir/authorized" ]] && access="writable"
  printf 'POWER\t%s\t%s\t%s\t%s\n' "$usb_id" "$state" "$access" "$(clean_field "$(usb_device_name "$dir")")"
}

set_power() {
  local usb_id="$1" mode="$2" dir value
  validate_usb_id "$usb_id"
  dir="/sys/bus/usb/devices/$usb_id"
  case "$mode" in
    on) value=1 ;;
    off)
      value=0
      usb_device_has_video_interface "$dir" \
        || die "Refusing to power off $usb_id: it does not expose a video interface." 2
      ;;
    *) die "Usage: webcamctl power <usb-id> on|off" ;;
  esac
  [[ -w "$dir/authorized" ]] \
    || die "Camera power control is not set up yet. Run the one-time setup from the panel." 3
  printf '%s' "$value" > "$dir/authorized" || die "Could not change the camera power state."
}

# One-time privileged setup: a udev rule hands the USB camera's "authorized"
# attribute to the current user so later toggles need no password.
power_setup() {
  local user rule
  user="$(id -un)"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Unsupported user name for the udev rule: $user"
  command -v pkexec >/dev/null 2>&1 || die "pkexec is required for the one-time setup."
  rule="$(printf '%s\n' \
    "# Webcam Controls for Omarchy: let $user power USB cameras on and off." \
    '# Cameras are matched by their USB Video Class control interface (0e01).' \
    'SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="", IMPORT{builtin}="usb_id"' \
    "SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_device\", ENV{ID_USB_INTERFACES}==\"*:0e01*\", RUN+=\"/bin/chown $user /sys%p/authorized\"")"
  pkexec /bin/sh -c '
    set -e
    rule="$1"; user="$2"
    printf "%s\n" "$rule" > /etc/udev/rules.d/90-webcam-power.rules
    udevadm control --reload
    for dev in /sys/bus/usb/devices/*; do
      [ -f "$dev/idVendor" ] && [ -f "$dev/authorized" ] || continue
      for class in "$dev"/*/bInterfaceClass; do
        [ -r "$class" ] || continue
        if [ "$(cat "$class")" = "0e" ]; then chown "$user" "$dev/authorized"; break; fi
      done
    done
  ' sh "$rule" "$user" || die "The camera power setup was cancelled or failed." 3
}

require_v4l2_ctl

case "${1:-}" in
  devices)
    (($# == 1)) || die "Usage: webcamctl devices"
    devices
    ;;
  state)
    (($# <= 2)) || die "Usage: webcamctl state [device]"
    state "${2:-}"
    ;;
  set)
    (($# == 4)) || die "Usage: webcamctl set <device> <control> <value>"
    set_control "$2" "$3" "$4"
    ;;
  power-state)
    (($# <= 2)) || die "Usage: webcamctl power-state [device|usb-id]"
    power_state "${2:-}"
    ;;
  power)
    (($# == 3)) || die "Usage: webcamctl power <usb-id> on|off"
    set_power "$2" "$3"
    ;;
  power-setup)
    (($# == 1)) || die "Usage: webcamctl power-setup"
    power_setup
    ;;
  *)
    die "Usage: webcamctl devices | state [device] | set <device> <control> <value> | power-state [device|usb-id] | power <usb-id> on|off | power-setup"
    ;;
esac
